# Copy this file to .env in the project root and fill in your own API key.
# Keep .env private. Never put a real key in this example file.
GEMINI_API_KEY=

# Optional: Gemini model used for intent parsing and search decisions.
GEMINI_MODEL=gemini-2.5-flash

# Optional: maximum listing pages per store (1-10).
SHOPPING_MAX_PAGES_PER_STORE=3

# Optional: maximum accepted products per store (1-100).
SHOPPING_MAX_PRODUCTS_PER_STORE=24

# Optional: positive HTTP timeout values, in seconds.
SHOPPING_HTTP_CONNECT_TIMEOUT=4
SHOPPING_HTTP_READ_TIMEOUT=8

# Optional: HTTP retry count (0-4). Use 0 to disable retries.
SHOPPING_HTTP_RETRIES=1

